{
  "_": "The row-level dimensions. A rule (admin console) lists the values of one dimension a person or group may see; cube.js adds `member in values` to every query that touches one of `cubes`. Different dimensions are ANDed, the values of one are ORed. This file is the stack's registry: the dimensions of every model it can serve (a dimension of a model that is not served is inert: no query touches its cubes), so Cube, the auth service and the admin console all enforce one list with one version. The auth and admin images copy it at build time; a test checks that each member is reachable from each cube. `when_empty`: deny = a person with no value gets nothing from those cubes, allow = no value means no restriction. `values`: list = the fixed values given, cube = the distinct values of the member (the console accepts any text).",
  "dimensions": [
    {
      "id": "territory",
      "labels": {
        "en": "Territories",
        "tr": "Bölgeler"
      },
      "member": "territories.region",
      "cubes": [
        "internet_sales",
        "reseller_sales",
        "territories"
      ],
      "values": {
        "kind": "list",
        "values": [
          "Australia",
          "Canada",
          "Central",
          "France",
          "Germany",
          "Northeast",
          "Northwest",
          "Southeast",
          "Southwest",
          "United Kingdom"
        ]
      },
      "when_empty": "deny",
      "empty_message": "No territories assigned"
    },
    {
      "id": "product_category",
      "labels": {
        "en": "Product categories",
        "tr": "Ürün kategorileri"
      },
      "member": "products.category",
      "cubes": [
        "internet_sales",
        "reseller_sales"
      ],
      "values": {
        "kind": "list",
        "values": [
          "Accessories",
          "Bikes",
          "Clothing",
          "Components",
          "Uncategorized"
        ]
      },
      "when_empty": "deny",
      "empty_message": "No product categories assigned"
    },
    {
      "id": "dealer_region",
      "labels": {
        "en": "Dealer regions",
        "tr": "Bayi bölgeleri"
      },
      "member": "dealers.region",
      "cubes": [
        "orders",
        "invoices",
        "payments",
        "returns",
        "dealers"
      ],
      "values": {
        "kind": "list",
        "values": [
          "Marmara",
          "Ege",
          "İç Anadolu",
          "Akdeniz",
          "Karadeniz",
          "Doğu Anadolu",
          "Güneydoğu Anadolu"
        ]
      },
      "when_empty": "allow",
      "empty_message": "No regions assigned"
    },
    {
      "id": "sales_rep",
      "labels": {
        "en": "Sales representative",
        "tr": "Satış temsilcisi"
      },
      "member": "dealers.rep_username",
      "cubes": [
        "orders",
