# Template for the SQL Server -> warehouse pipeline.
#
# Copy to `secrets.toml` in this directory (git-ignored) and fill in the real
# SQL Server values. Never commit the filled-in file: this repository is public.
#
#   cp secrets.toml.example secrets.toml
#
# The SQL Server login/password are real secrets and stay here. The warehouse
# (destination) password is not stored here: it is read from the
# `POSTGRES_PASSWORD` environment variable set in `.env`. `config.toml` holds
# the non-secret destination settings (host/port/database).

[sources.sql_database.credentials]
drivername = "mssql+pyodbc"
database = "AdventureWorks2016"
username = "REPLACE_ME"
password = "REPLACE_ME"
host = "REPLACE_ME"
port = 1433

[sources.sql_database.credentials.query]
driver = "ODBC Driver 18 for SQL Server"
TrustServerCertificate = "yes"
