# Template for the postgres_active -> warehouse CDC pipeline.
#
# Copy to `secrets.toml` in this directory (git-ignored):
#
#   cp secrets.toml.example secrets.toml
#
# The Postgres password is NOT stored here: both the source and the destination
# read it from the `POSTGRES_PASSWORD` environment variable set in `.env`
# (dlt gives secrets.toml a higher priority than env vars, so the pipelines
# apply the env value explicitly). The `password` line below is only a fallback
# for running the pipeline outside the stack; leave it as REPLACE_ME if you
# always run it through Airflow.
#
# `config.toml` holds the non-secret destination settings (host/port/database).

[sources.sql_database.credentials]
drivername = "postgresql+psycopg2"
database = "active_db"
username = "postgres"
password = "REPLACE_ME"
host = "postgres_active"
port = 5434
