# Template for the postgres_active -> warehouse (AdventureWorks) pipeline's dlt
# secrets.
#
# Copy to `secrets.toml` (git-ignored):
#
#   cp secrets.toml.example secrets.toml
#
# The real Postgres password comes from POSTGRES_PASSWORD in .env and is applied
# by dlt/pipelines/stack_credentials.py. dlt 1.30 requires credentials to resolve
# from a secrets provider, so these sections must exist in secrets.toml even
# though the placeholder values below are never used for the connection.
[destination.postgres.credentials]
password = "REPLACE_ME"

[sources.sql_database.credentials]
password = "REPLACE_ME"
