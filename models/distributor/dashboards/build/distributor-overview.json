{
  "spec": 1,
  "model": "distributor",
  "id": "distributor-overview",
  "title": "Satış özeti",
  "description": "Ciro, marj, sipariş ve tahsilat; yıl, bölge ve bayi tipine göre.",
  "tags": [
    "dağıtım"
  ],
  "locale": "tr-TR",
  "currency": "TRY",
  "time": {
    "dimension": "calendar.full_date"
  },
  "filters": [
    {
      "id": "year",
      "dimension": "calendar.calendar_year",
      "label": "Yıl"
    },
    {
      "id": "region",
      "dimension": "dealers.region",
      "label": "Bölge"
    },
    {
      "id": "segment",
      "dimension": "dealers.segment",
      "label": "Bayi tipi"
    },
    {
      "id": "xf_categories_1",
      "dimension": "items.category",
      "label": "Category",
      "implicit": true,
      "source": "categories"
    }
  ],
  "panels": [
    {
      "id": "kpis",
      "type": "kpi",
      "compare": "previous_year",
      "measures": [
        {
          "member": "orders.revenue",
          "label": "Ciro",
          "format": "money"
        },
        {
          "member": "orders.gross_margin",
          "label": "Brüt kâr",
          "format": "money"
        },
        {
          "member": "orders.order_count",
          "label": "Sipariş",
          "format": "int"
        },
        {
          "member": "payments.collected",
          "label": "Tahsilat",
          "format": "money"
        }
      ],
      "sparkline": {
        "granularity": "month"
      },
      "ignore_filters": [
        "xf_categories_1"
      ]
    },
    {
      "id": "trend",
      "type": "timeseries",
      "title": "Aylık ciro ve tahsilat",
      "series": [
        {
          "member": "orders.revenue",
          "label": "Ciro",
          "color": "focus",
          "format": "money"
        },
        {
          "member": "payments.collected",
          "label": "Tahsilat",
          "color": "good",
          "format": "money"
        }
      ],
      "granularity": "month",
      "style": "line",
      "ignore_filters": [
        "xf_categories_1"
      ]
    },
    {
      "id": "segments",
      "type": "pie",
      "title": "Bayi tipine göre ciro",
      "measure": "orders.revenue",
      "by": "dealers.segment",
      "on_click": {
        "set_filter": "segment"
      }
    },
    {
      "id": "regions",
      "type": "bar",
      "title": "Bölgeye göre ciro",
      "by": "dealers.region",
      "measure": "orders.revenue",
      "sort": "desc",
      "format": "money",
      "on_click": {
        "set_filter": "region"
      }
    },
    {
      "id": "categories",
      "type": "bar",
      "title": "Kategoriye göre ciro",
      "by": "items.category",
      "measure": "orders.revenue",
      "sort": "desc",
      "format": "money",
      "on_click": {
        "set_filter": [
          "xf_categories_1"
        ]
      }
    }
  ],
  "layout": [
    [
      {
        "panel": "kpis",
        "span": 12
      }
    ],
    [
      {
        "panel": "trend",
        "span": 8
      },
      {
        "panel": "segments",
        "span": 4
      }
    ],
    [
      {
        "panel": "regions",
        "span": 6
      },
      {
        "panel": "categories",
        "span": 6
      }
    ]
  ],
  "members": {
    "calendar.calendar_year": {
      "kind": "dimension",
      "type": "number"
    },
    "calendar.full_date": {
      "kind": "dimension",
      "type": "time"
    },
    "dealers.region": {
      "kind": "dimension",
      "type": "string"
    },
    "dealers.segment": {
      "kind": "dimension",
      "type": "string"
    },
    "items.category": {
      "kind": "dimension",
      "type": "string"
    },
    "orders.gross_margin": {
      "kind": "measure",
      "type": "sum"
    },
    "orders.order_count": {
      "kind": "measure",
      "type": "count_distinct"
    },
    "orders.revenue": {
      "kind": "measure",
      "type": "sum"
    },
    "payments.collected": {
      "kind": "measure",
      "type": "sum"
    }
  },
  "yearFields": {
    "calendar": [
      "calendar.calendar_year",
      "maturity_dates.calendar_year"
    ]
  },
  "cubes": {
    "calendar": {
      "joins": []
    },
    "dealers": {
      "joins": [
        "reps"
      ]
    },
    "items": {
      "joins": []
    },
    "orders": {
      "joins": [
        "calendar",
        "dealers",
        "items"
      ]
    },
    "payments": {
      "joins": [
        "calendar",
        "dealers"
      ]
    }
  }
}
