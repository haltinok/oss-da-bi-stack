{
  "spec": 1,
  "model": "distributor",
  "id": "collections",
  "title": "Tahsilat ve vade",
  "description": "Faturalanan, tahsil edilen, açık ve vadesi geçmiş bakiye; vade yaşlandırması.",
  "tags": [
    "dağıtım"
  ],
  "locale": "tr-TR",
  "currency": "TRY",
  "time": {
    "dimension": "calendar.full_date"
  },
  "filters": [
    {
      "id": "year",
      "dimension": "calendar.calendar_year",
      "label": "Yıl"
    },
    {
      "id": "region",
      "dimension": "dealers.region",
      "label": "Bölge"
    },
    {
      "id": "xf_methods_1",
      "dimension": "payments.method",
      "label": "Method",
      "implicit": true,
      "source": "methods"
    },
    {
      "id": "xf_aging_1",
      "dimension": "invoices.aging_bucket",
      "label": "Aging bucket",
      "implicit": true,
      "source": "aging"
    },
    {
      "id": "xf_overdue_1",
      "dimension": "dealers.name",
      "label": "Name",
      "implicit": true,
      "source": "overdue"
    }
  ],
  "panels": [
    {
      "id": "kpis",
      "type": "kpi",
      "measures": [
        {
          "member": "invoices.invoiced",
          "label": "Faturalanan",
          "format": "money"
        },
        {
          "member": "payments.collected",
          "label": "Tahsilat",
          "format": "money"
        },
        {
          "member": "invoices.open_balance",
          "label": "Açık bakiye",
          "format": "money"
        },
        {
          "member": "invoices.overdue_balance",
          "label": "Vadesi geçmiş",
          "format": "money"
        }
      ],
      "ignore_filters": [
        "xf_methods_1",
        "xf_aging_1"
      ]
    },
    {
      "id": "trend",
      "type": "timeseries",
      "title": "Aylık fatura ve tahsilat",
      "series": [
        {
          "member": "invoices.invoiced",
          "label": "Fatura",
          "color": "focus",
          "format": "money"
        },
        {
          "member": "payments.collected",
          "label": "Tahsilat",
          "color": "good",
          "format": "money"
        }
      ],
      "granularity": "month",
      "style": "line",
      "ignore_filters": [
        "xf_methods_1",
        "xf_aging_1"
      ]
    },
    {
      "id": "methods",
      "type": "pie",
      "title": "Ödeme yöntemi",
      "measure": "payments.collected",
      "by": "payments.method",
      "on_click": {
        "set_filter": [
          "xf_methods_1"
        ]
      },
      "ignore_filters": [
        "xf_aging_1"
      ]
    },
    {
      "id": "aging",
      "type": "bar",
      "title": "Vade yaşlandırması (açık bakiye)",
      "by": "invoices.aging_bucket",
      "measure": "invoices.open_balance",
      "format": "money",
      "on_click": {
        "set_filter": [
          "xf_aging_1"
        ]
      },
      "ignore_filters": [
        "xf_methods_1"
      ]
    },
    {
      "id": "overdue",
      "type": "bar",
      "title": "Vadesi geçmiş bakiye, bayiye göre",
      "by": "dealers.name",
      "measure": "invoices.overdue_balance",
      "sort": "desc",
      "limit": 10,
      "format": "money",
      "on_click": {
        "set_filter": [
          "xf_overdue_1"
        ]
      },
      "ignore_filters": [
        "xf_methods_1"
      ]
    }
  ],
  "layout": [
    [
      {
        "panel": "kpis",
        "span": 12
      }
    ],
    [
      {
        "panel": "trend",
        "span": 8
      },
      {
        "panel": "methods",
        "span": 4
      }
    ],
    [
      {
        "panel": "aging",
        "span": 6
      },
      {
        "panel": "overdue",
        "span": 6
      }
    ]
  ],
  "members": {
    "calendar.calendar_year": {
      "kind": "dimension",
      "type": "number"
    },
    "calendar.full_date": {
      "kind": "dimension",
      "type": "time"
    },
    "dealers.name": {
      "kind": "dimension",
      "type": "string"
    },
    "dealers.region": {
      "kind": "dimension",
      "type": "string"
    },
    "invoices.aging_bucket": {
      "kind": "dimension",
      "type": "string",
      "sort_by": "invoices.aging_order"
    },
    "invoices.invoiced": {
      "kind": "measure",
      "type": "sum"
    },
    "invoices.open_balance": {
      "kind": "measure",
      "type": "sum"
    },
    "invoices.overdue_balance": {
      "kind": "measure",
      "type": "sum"
    },
    "payments.collected": {
      "kind": "measure",
      "type": "sum"
    },
    "payments.method": {
      "kind": "dimension",
      "type": "string"
    }
  },
  "yearFields": {
    "calendar": [
      "calendar.calendar_year",
      "maturity_dates.calendar_year"
    ]
  },
  "cubes": {
    "calendar": {
      "joins": []
    },
    "dealers": {
      "joins": [
        "reps"
      ]
    },
    "invoices": {
      "joins": [
        "calendar",
        "dealers",
        "maturity_dates"
      ]
    },
    "payments": {
      "joins": [
        "calendar",
        "dealers"
      ]
    }
  }
}
