{
  "spec": 1,
  "model": "distributor",
  "id": "returns",
  "title": "İade analizi",
  "description": "İade tutarı, nedenler ve en çok iade edilen ürünler.",
  "tags": [
    "dağıtım"
  ],
  "locale": "tr-TR",
  "currency": "TRY",
  "time": {
    "dimension": "calendar.full_date"
  },
  "filters": [
    {
      "id": "year",
      "dimension": "calendar.calendar_year",
      "label": "Yıl"
    },
    {
      "id": "region",
      "dimension": "dealers.region",
      "label": "Bölge"
    },
    {
      "id": "xf_reasons_1",
      "dimension": "returns.reason",
      "label": "Reason",
      "implicit": true,
      "source": "reasons"
    },
    {
      "id": "xf_items_1",
      "dimension": "items.name",
      "label": "Name",
      "implicit": true,
      "source": "items"
    },
    {
      "id": "xf_dealers_1",
      "dimension": "dealers.name",
      "label": "Name",
      "implicit": true,
      "source": "dealers"
    }
  ],
  "panels": [
    {
      "id": "kpis",
      "type": "kpi",
      "measures": [
        {
          "member": "returns.returned_amount",
          "label": "İade tutarı",
          "format": "money"
        },
        {
          "member": "returns.returned_quantity",
          "label": "İade adedi",
          "format": "int"
        },
        {
          "member": "returns.return_count",
          "label": "İade",
          "format": "int"
        }
      ]
    },
    {
      "id": "trend",
      "type": "timeseries",
      "title": "Aylık iade tutarı",
      "series": [
        {
          "member": "returns.returned_amount",
          "label": "İade",
          "color": "bad",
          "format": "money"
        }
      ],
      "granularity": "month",
      "style": "bar"
    },
    {
      "id": "reasons",
      "type": "pie",
      "title": "İade nedeni",
      "measure": "returns.returned_amount",
      "by": "returns.reason",
      "on_click": {
        "set_filter": [
          "xf_reasons_1"
        ]
      }
    },
    {
      "id": "items",
      "type": "bar",
      "title": "En çok iade edilen ürünler",
      "by": "items.name",
      "measure": "returns.returned_amount",
      "sort": "desc",
      "limit": 10,
      "format": "money",
      "on_click": {
        "set_filter": [
          "xf_items_1"
        ]
      }
    },
    {
      "id": "dealers",
      "type": "bar",
      "title": "Bayiye göre iade",
      "by": "dealers.name",
      "measure": "returns.returned_amount",
      "sort": "desc",
      "limit": 10,
      "format": "money",
      "on_click": {
        "set_filter": [
          "xf_dealers_1"
        ]
      }
    }
  ],
  "layout": [
    [
      {
        "panel": "kpis",
        "span": 12
      }
    ],
    [
      {
        "panel": "trend",
        "span": 8
      },
      {
        "panel": "reasons",
        "span": 4
      }
    ],
    [
      {
        "panel": "items",
        "span": 6
      },
      {
        "panel": "dealers",
        "span": 6
      }
    ]
  ],
  "members": {
    "calendar.calendar_year": {
      "kind": "dimension",
      "type": "number"
    },
    "calendar.full_date": {
      "kind": "dimension",
      "type": "time"
    },
    "dealers.name": {
      "kind": "dimension",
      "type": "string"
    },
    "dealers.region": {
      "kind": "dimension",
      "type": "string"
    },
    "items.name": {
      "kind": "dimension",
      "type": "string"
    },
    "returns.reason": {
      "kind": "dimension",
      "type": "string"
    },
    "returns.return_count": {
      "kind": "measure",
      "type": "count"
    },
    "returns.returned_amount": {
      "kind": "measure",
      "type": "sum"
    },
    "returns.returned_quantity": {
      "kind": "measure",
      "type": "sum"
    }
  },
  "yearFields": {
    "calendar": [
      "calendar.calendar_year",
      "maturity_dates.calendar_year"
    ]
  },
  "cubes": {
    "calendar": {
      "joins": []
    },
    "dealers": {
      "joins": [
        "reps"
      ]
    },
    "items": {
      "joins": []
    },
    "returns": {
      "joins": [
        "calendar",
        "dealers",
        "items"
      ]
    }
  }
}
