{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dashboard.schema.json",
  "title": "Dashboard spec v1",
  "type": "object",
  "required": ["spec", "id", "title", "time", "panels", "layout"],
  "additionalProperties": false,
  "properties": {
    "spec": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 24 }, "maxItems": 5, "uniqueItems": true },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "roles": {
      "type": "array",
      "items": { "enum": ["admin", "manager", "rep", "purchasing", "marketing"] },
      "minItems": 1,
      "uniqueItems": true
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "maxLength": 60 },
        "logo": { "type": "string", "pattern": "^(/|https://)[^\\s\"'<>]+$" },
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "internet": { "$ref": "#/$defs/hex" },
            "reseller": { "$ref": "#/$defs/hex" },
            "focus": { "$ref": "#/$defs/hex" },
            "live": { "$ref": "#/$defs/hex" },
            "good": { "$ref": "#/$defs/hex" },
            "bad": { "$ref": "#/$defs/hex" },
            "warn": { "$ref": "#/$defs/hex" }
          }
        }
      }
    },
    "time": {
      "type": "object",
      "required": ["dimension"],
      "additionalProperties": false,
      "properties": {
        "dimension": { "$ref": "#/$defs/member" },
        "fiscal_year_start": { "type": "integer", "minimum": 1, "maximum": 12 }
      }
    },
    "filters": { "type": "array", "items": { "$ref": "#/$defs/filter" } },
    "panels": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/panel" } },
    "layout": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": { "type": "integer", "minimum": 1, "maximum": 12 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "member": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
    "format": { "enum": ["money", "int", "decimal", "pct", "number"] },
    "granularity": { "enum": ["hour", "day", "week", "month", "quarter", "year"] },
    "direction": { "enum": ["asc", "desc"] },
    "filter": {
      "type": "object",
      "required": ["id", "dimension"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dimension": { "$ref": "#/$defs/member" },
        "label": { "type": "string" },
        "parent": { "$ref": "#/$defs/member" }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member": { "$ref": "#/$defs/member" },
        "sum": { "type": "array", "items": { "$ref": "#/$defs/member" }, "minItems": 2 },
        "ratio": {
          "type": "object",
          "required": ["num", "den"],
          "additionalProperties": false,
          "properties": {
            "num": { "type": "array", "items": { "$ref": "#/$defs/member" }, "minItems": 1 },
            "den": { "type": "array", "items": { "$ref": "#/$defs/member" }, "minItems": 1 }
          }
        },
        "label": { "type": "string" },
        "format": { "$ref": "#/$defs/format" }
      },
      "oneOf": [{ "required": ["member"] }, { "required": ["sum", "label"] }, { "required": ["ratio", "label"] }]
    },
    "column": {
      "anyOf": [
        { "$ref": "#/$defs/member" },
        {
          "type": "object",
          "required": ["member"],
          "additionalProperties": false,
          "properties": {
            "member": { "$ref": "#/$defs/member" },
            "label": { "type": "string" },
            "format": { "$ref": "#/$defs/format" }
          }
        }
      ]
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "member": { "$ref": "#/$defs/member" },
        "sum": { "type": "array", "items": { "$ref": "#/$defs/member" }, "minItems": 2 },
        "ratio": { "$ref": "#/$defs/measure/properties/ratio" },
        "label": { "type": "string" },
        "color": { "type": "string" },
        "format": { "$ref": "#/$defs/format" }
      },
      "oneOf": [{ "required": ["member"] }, { "required": ["sum", "label"] }, { "required": ["ratio", "label"] }]
    },
    "on_click": {
      "type": "object",
      "required": ["set_filter"],
      "additionalProperties": false,
      "properties": {
        "set_filter": {
          "oneOf": [
            { "$ref": "#/$defs/id" },
            { "type": "array", "items": { "$ref": "#/$defs/id" }, "minItems": 1, "maxItems": 2 }
          ]
        }
      }
    },
    "panel": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["kpi", "timeseries", "bar", "pie", "treemap", "table", "pivot", "text"] },
        "title": { "type": "string" },
        "ignore_filters": { "type": "array", "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
      },
      "unevaluatedProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "kpi" } } },
          "then": {
            "required": ["measures"],
            "properties": {
              "measures": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/measure" } },
              "sparkline": {
                "type": "object",
                "required": ["granularity"],
                "additionalProperties": false,
                "properties": { "granularity": { "$ref": "#/$defs/granularity" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "timeseries" } } },
          "then": {
            "required": ["series", "granularity"],
            "properties": {
              "series": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/series" } },
              "granularity": { "$ref": "#/$defs/granularity" },
              "granularities": { "type": "array", "items": { "$ref": "#/$defs/granularity" }, "minItems": 2, "uniqueItems": true },
              "drill": { "type": "array", "items": { "$ref": "#/$defs/granularity" }, "minItems": 2, "maxItems": 4, "uniqueItems": true },
              "style": { "enum": ["line", "area", "stacked-area", "bar", "stacked-bar"] },
              "on_click": { "$ref": "#/$defs/on_click" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "bar" } } },
          "then": {
            "required": ["by"],
            "oneOf": [{ "required": ["measure"] }, { "required": ["stack"] }],
            "properties": {
              "measure": { "$ref": "#/$defs/member" },
              "label": { "type": "string" },
              "by_label": { "type": "string" },
              "stack": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["member"],
                  "additionalProperties": false,
                  "properties": { "member": { "$ref": "#/$defs/member" }, "label": { "type": "string" }, "color": { "type": "string" } }
                }
              },
              "by": { "$ref": "#/$defs/member" },
              "split": { "$ref": "#/$defs/member" },
              "sort": { "$ref": "#/$defs/direction" },
              "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "orientation": { "enum": ["horizontal", "vertical"] },
              "format": { "$ref": "#/$defs/format" },
              "on_click": { "$ref": "#/$defs/on_click" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pie" } } },
          "then": {
            "required": ["by"],
            "oneOf": [{ "required": ["measure"] }, { "required": ["sum", "label"] }],
            "properties": {
              "measure": { "$ref": "#/$defs/member" },
              "sum": { "type": "array", "items": { "$ref": "#/$defs/member" }, "minItems": 2 },
              "label": { "type": "string" },
              "by": { "$ref": "#/$defs/member" },
              "by_label": { "type": "string" },
              "limit": { "type": "integer", "minimum": 2, "maximum": 30 },
              "style": { "enum": ["pie", "donut"] },
              "format": { "$ref": "#/$defs/format" },
              "on_click": { "$ref": "#/$defs/on_click" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "treemap" } } },
          "then": {
            "required": ["measure", "group"],
            "properties": {
              "measure": { "$ref": "#/$defs/member" },
              "label": { "type": "string" },
              "group": { "type": "array", "items": { "$ref": "#/$defs/member" }, "minItems": 1, "maxItems": 2 },
              "group_labels": { "type": "array", "items": { "type": "string" }, "minItems": 1, "maxItems": 2 },
              "format": { "$ref": "#/$defs/format" },
              "on_click": { "$ref": "#/$defs/on_click" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "table" } } },
          "then": {
            "required": ["columns"],
            "properties": {
              "columns": { "type": "array", "items": { "$ref": "#/$defs/column" }, "minItems": 1, "maxItems": 20 },
              "order": { "type": "object", "additionalProperties": { "$ref": "#/$defs/direction" } },
              "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
              "totals": { "enum": ["header", "footer"] },
              "on_click": { "$ref": "#/$defs/on_click" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "pivot" } } },
          "then": {
            "required": ["rows", "columns", "measures"],
            "properties": {
              "rows": { "type": "array", "items": { "$ref": "#/$defs/member" }, "minItems": 1, "maxItems": 2, "uniqueItems": true },
              "columns": {
                "oneOf": [
                  { "$ref": "#/$defs/member" },
                  {
                    "type": "object",
                    "required": ["member", "granularity"],
                    "additionalProperties": false,
                    "properties": { "member": { "$ref": "#/$defs/member" }, "granularity": { "$ref": "#/$defs/granularity" } }
                  }
                ]
              },
              "measures": { "type": "array", "items": { "$ref": "#/$defs/column" }, "minItems": 1, "maxItems": 3 },
              "show": { "enum": ["value", "share_of_row", "share_of_column", "share_of_total"] },
              "heat": {
                "type": "object",
                "required": ["measure"],
                "additionalProperties": false,
                "properties": { "measure": { "$ref": "#/$defs/member" } }
              },
              "totals": { "enum": ["both", "rows", "columns", "none"] },
              "order": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "by": { "enum": ["total", "label"] }, "dir": { "$ref": "#/$defs/direction" } }
              },
              "limit": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "rows": { "type": "integer", "minimum": 1, "maximum": 200 },
                  "columns": { "type": "integer", "minimum": 1, "maximum": 24 }
                }
              },
              "on_click": { "$ref": "#/$defs/on_click" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": {
            "required": ["markdown"],
            "properties": { "markdown": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  }
}
