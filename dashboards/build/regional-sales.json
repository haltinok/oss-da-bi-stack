{
  "spec": 1,
  "id": "regional-sales",
  "title": "Regional sales",
  "description": "Revenue and orders by territory and product. No cost or profit figures, so it is the same for a manager and a rep; each sees only their own territories.",
  "tags": [
    "sales",
    "regional"
  ],
  "locale": "en-US",
  "currency": "USD",
  "roles": [
    "manager",
    "rep"
  ],
  "time": {
    "dimension": "dates.full_date",
    "fiscal_year_start": 7
  },
  "filters": [
    {
      "id": "fy",
      "dimension": "dates.fiscal_year",
      "label": "Fiscal year"
    }
  ],
  "panels": [
    {
      "id": "kpis",
      "type": "kpi",
      "measures": [
        {
          "sum": [
            "internet_sales.revenue",
            "reseller_sales.revenue"
          ],
          "label": "Revenue",
          "format": "money"
        },
        {
          "sum": [
            "internet_sales.orders",
            "reseller_sales.orders"
          ],
          "label": "Orders",
          "format": "int"
        },
        {
          "ratio": {
            "num": [
              "internet_sales.revenue",
              "reseller_sales.revenue"
            ],
            "den": [
              "internet_sales.orders",
              "reseller_sales.orders"
            ]
          },
          "label": "Avg order value",
          "format": "money"
        },
        {
          "sum": [
            "internet_sales.units",
            "reseller_sales.units"
          ],
          "label": "Units sold",
          "format": "int"
        }
      ],
      "sparkline": {
        "granularity": "month"
      }
    },
    {
      "id": "trend",
      "type": "timeseries",
      "title": "Monthly revenue by channel",
      "series": [
        {
          "member": "internet_sales.revenue",
          "label": "Internet",
          "color": "internet",
          "format": "money"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller",
          "color": "reseller",
          "format": "money"
        }
      ],
      "granularity": "month",
      "style": "stacked-bar",
      "on_click": {
        "set_filter": "fy"
      }
    },
    {
      "id": "countries",
      "type": "bar",
      "title": "Revenue by country",
      "stack": [
        {
          "member": "internet_sales.revenue",
          "label": "Internet",
          "color": "internet"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller",
          "color": "reseller"
        }
      ],
      "by": "territories.country",
      "sort": "desc",
      "limit": 15,
      "format": "money"
    },
    {
      "id": "products",
      "type": "bar",
      "title": "Top products",
      "stack": [
        {
          "member": "internet_sales.revenue",
          "label": "Internet",
          "color": "internet"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller",
          "color": "reseller"
        }
      ],
      "by": "products.name",
      "sort": "desc",
      "limit": 10,
      "format": "money"
    }
  ],
  "layout": [
    [
      {
        "panel": "kpis",
        "span": 12
      }
    ],
    [
      {
        "panel": "trend",
        "span": 12
      }
    ],
    [
      {
        "panel": "countries",
        "span": 6
      },
      {
        "panel": "products",
        "span": 6
      }
    ]
  ],
  "members": {
    "dates.fiscal_year": {
      "kind": "dimension",
      "type": "number"
    },
    "dates.full_date": {
      "kind": "dimension",
      "type": "time"
    },
    "internet_sales.orders": {
      "kind": "measure",
      "type": "count_distinct"
    },
    "internet_sales.revenue": {
      "kind": "measure",
      "type": "sum"
    },
    "internet_sales.units": {
      "kind": "measure",
      "type": "sum"
    },
    "products.name": {
      "kind": "dimension",
      "type": "string"
    },
    "reseller_sales.orders": {
      "kind": "measure",
      "type": "count_distinct"
    },
    "reseller_sales.revenue": {
      "kind": "measure",
      "type": "sum"
    },
    "reseller_sales.units": {
      "kind": "measure",
      "type": "sum"
    },
    "territories.country": {
      "kind": "dimension",
      "type": "string"
    }
  },
  "cubes": {
    "dates": {
      "joins": []
    },
    "internet_sales": {
      "joins": [
        "customers",
        "dates",
        "due_dates",
        "products",
        "ship_dates",
        "territories"
      ]
    },
    "products": {
      "joins": []
    },
    "reseller_sales": {
      "joins": [
        "dates",
        "due_dates",
        "products",
        "ship_dates",
        "territories"
      ]
    },
    "territories": {
      "joins": []
    }
  }
}
