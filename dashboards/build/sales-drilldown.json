{
  "spec": 1,
  "id": "sales-drilldown",
  "title": "Sales drill-down",
  "description": "Revenue over time that drills from year to month to day, a donut by subcategory and columns by category. Every click filters the rest.",
  "tags": [
    "sales"
  ],
  "locale": "en-US",
  "currency": "USD",
  "time": {
    "dimension": "dates.full_date",
    "fiscal_year_start": 7
  },
  "calculations": [
    {
      "id": "revenue_yoy",
      "label": "Revenue vs last year",
      "formula": "(internet_sales.revenue + reseller_sales.revenue - prior(internet_sales.revenue, year) - prior(reseller_sales.revenue, year)) / (prior(internet_sales.revenue, year) + prior(reseller_sales.revenue, year))",
      "format": "pct"
    },
    {
      "id": "revenue_r12",
      "label": "Revenue, last 12 months",
      "formula": "rolling(internet_sales.revenue, 12) + rolling(reseller_sales.revenue, 12)",
      "format": "money"
    }
  ],
  "filters": [
    {
      "id": "category",
      "dimension": "products.category",
      "label": "Category"
    },
    {
      "id": "subcategory",
      "dimension": "products.subcategory",
      "label": "Subcategory",
      "parent": "products.category"
    },
    {
      "id": "region",
      "dimension": "territories.region",
      "label": "Region"
    },
    {
      "id": "sl_group",
      "dimension": "territories.group_name",
      "label": "Sales group",
      "source": "group"
    },
    {
      "id": "xf_growth_1",
      "dimension": "dates.fiscal_year",
      "label": "Fiscal year",
      "implicit": true,
      "source": "growth"
    }
  ],
  "panels": [
    {
      "id": "group",
      "type": "slicer",
      "display": "chips",
      "filter": "sl_group",
      "title": "Sales group"
    },
    {
      "id": "kpis",
      "type": "kpi",
      "compare": "previous_period",
      "measures": [
        {
          "sum": [
            "internet_sales.revenue",
            "reseller_sales.revenue"
          ],
          "label": "Revenue",
          "format": "money"
        },
        {
          "sum": [
            "internet_sales.orders",
            "reseller_sales.orders"
          ],
          "label": "Orders",
          "format": "int"
        },
        {
          "ratio": {
            "num": [
              "internet_sales.revenue",
              "reseller_sales.revenue"
            ],
            "den": [
              "internet_sales.orders",
              "reseller_sales.orders"
            ]
          },
          "label": "Avg order value",
          "format": "money"
        },
        {
          "sum": [
            "internet_sales.units",
            "reseller_sales.units"
          ],
          "label": "Units sold",
          "format": "int"
        }
      ],
      "sparkline": {
        "granularity": "month"
      }
    },
    {
      "id": "trend",
      "type": "timeseries",
      "title": "Revenue by channel",
      "series": [
        {
          "member": "internet_sales.revenue",
          "label": "Internet",
          "color": "series1",
          "format": "money"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller",
          "color": "series2",
          "format": "money"
        }
      ],
      "granularity": "year",
      "drill": [
        "year",
        "month",
        "day"
      ],
      "style": "stacked-area"
    },
    {
      "id": "donut",
      "type": "pie",
      "title": "Revenue by subcategory",
      "sum": [
        "internet_sales.revenue",
        "reseller_sales.revenue"
      ],
      "label": "Revenue",
      "by": "products.subcategory",
      "by_label": "Subcategory",
      "limit": 8,
      "style": "donut",
      "format": "money",
      "on_click": {
        "set_filter": "subcategory"
      }
    },
    {
      "id": "categories",
      "type": "bar",
      "title": "Revenue by category",
      "orientation": "vertical",
      "stack": [
        {
          "member": "internet_sales.revenue",
          "label": "Internet",
          "color": "series1"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller",
          "color": "series2"
        }
      ],
      "by": "products.category",
      "sort": "desc",
      "limit": 6,
      "format": "money",
      "on_click": {
        "set_filter": "category"
      }
    },
    {
      "id": "regions",
      "type": "bar",
      "title": "Revenue by region",
      "stack": [
        {
          "member": "internet_sales.revenue",
          "label": "Internet",
          "color": "series1"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller",
          "color": "series2"
        }
      ],
      "by": "territories.region",
      "sort": "desc",
      "limit": 10,
      "format": "money",
      "on_click": {
        "set_filter": "region"
      }
    },
    {
      "id": "growth",
      "type": "timeseries",
      "title": "Revenue growth on the year before",
      "series": [
        {
          "member": "calc.revenue_yoy",
          "label": "vs last year",
          "color": "series1",
          "format": "pct"
        }
      ],
      "granularity": "month",
      "style": "bar",
      "on_click": {
        "set_filter": [
          "xf_growth_1"
        ]
      }
    },
    {
      "id": "rolling",
      "type": "timeseries",
      "title": "Revenue, rolling 12 months",
      "series": [
        {
          "member": "calc.revenue_r12",
          "label": "Last 12 months",
          "color": "series1",
          "format": "money"
        },
        {
          "sum": [
            "internet_sales.revenue",
            "reseller_sales.revenue"
          ],
          "label": "The month",
          "color": "series2",
          "format": "money"
        }
      ],
      "granularity": "month",
      "style": "line",
      "on_click": {
        "set_filter": [
          "xf_growth_1"
        ]
      }
    },
    {
      "id": "detail",
      "type": "table",
      "title": "Revenue by subcategory",
      "columns": [
        {
          "member": "products.category",
          "label": "Category"
        },
        {
          "member": "products.subcategory",
          "label": "Subcategory"
        },
        {
          "member": "internet_sales.revenue",
          "label": "Internet revenue",
          "format": "money"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller revenue",
          "format": "money"
        },
        {
          "member": "internet_sales.margin_pct",
          "label": "Internet margin",
          "format": "pct"
        },
        {
          "member": "reseller_sales.margin_pct",
          "label": "Reseller margin",
          "format": "pct"
        }
      ],
      "order": {
        "internet_sales.revenue": "desc"
      },
      "limit": 50,
      "totals": "footer"
    }
  ],
  "model": "adventureworks",
  "layout": [
    [
      {
        "panel": "kpis",
        "span": 12
      }
    ],
    [
      {
        "panel": "group",
        "span": 12
      }
    ],
    [
      {
        "panel": "trend",
        "span": 7
      },
      {
        "panel": "donut",
        "span": 5
      }
    ],
    [
      {
        "panel": "categories",
        "span": 6
      },
      {
        "panel": "regions",
        "span": 6
      }
    ],
    [
      {
        "panel": "growth",
        "span": 6
      },
      {
        "panel": "rolling",
        "span": 6
      }
    ],
    [
      {
        "panel": "detail",
        "span": 12
      }
    ]
  ],
  "members": {
    "calc.revenue_r12": {
      "kind": "measure",
      "type": "number",
      "label": "Revenue, last 12 months",
      "calc": {
        "ast": {
          "op": "+",
          "a": {
            "rolling": "internet_sales.revenue",
            "over": 12
          },
          "b": {
            "rolling": "reseller_sales.revenue",
            "over": 12
          }
        },
        "members": [
          "internet_sales.revenue",
          "reseller_sales.revenue"
        ]
      },
      "format": "money"
    },
    "calc.revenue_yoy": {
      "kind": "measure",
      "type": "number",
      "label": "Revenue vs last year",
      "calc": {
        "ast": {
          "op": "/",
          "a": {
            "op": "-",
            "a": {
              "op": "-",
              "a": {
                "op": "+",
                "a": {
                  "m": "internet_sales.revenue"
                },
                "b": {
                  "m": "reseller_sales.revenue"
                }
              },
              "b": {
                "prior": "internet_sales.revenue",
                "by": "year"
              }
            },
            "b": {
              "prior": "reseller_sales.revenue",
              "by": "year"
            }
          },
          "b": {
            "op": "+",
            "a": {
              "prior": "internet_sales.revenue",
              "by": "year"
            },
            "b": {
              "prior": "reseller_sales.revenue",
              "by": "year"
            }
          }
        },
        "members": [
          "internet_sales.revenue",
          "reseller_sales.revenue"
        ]
      },
      "format": "pct"
    },
    "dates.full_date": {
      "kind": "dimension",
      "type": "time"
    },
    "internet_sales.margin_pct": {
      "kind": "measure",
      "type": "number"
    },
    "internet_sales.orders": {
      "kind": "measure",
      "type": "count_distinct"
    },
    "internet_sales.revenue": {
      "kind": "measure",
      "type": "sum"
    },
    "internet_sales.units": {
      "kind": "measure",
      "type": "sum"
    },
    "products.category": {
      "kind": "dimension",
      "type": "string"
    },
    "products.subcategory": {
      "kind": "dimension",
      "type": "string"
    },
    "reseller_sales.margin_pct": {
      "kind": "measure",
      "type": "number"
    },
    "reseller_sales.orders": {
      "kind": "measure",
      "type": "count_distinct"
    },
    "reseller_sales.revenue": {
      "kind": "measure",
      "type": "sum"
    },
    "reseller_sales.units": {
      "kind": "measure",
      "type": "sum"
    },
    "territories.group_name": {
      "kind": "dimension",
      "type": "string"
    },
    "territories.region": {
      "kind": "dimension",
      "type": "string"
    }
  },
  "yearFields": {
    "fiscal": [
      "dates.fiscal_year",
      "due_dates.fiscal_year",
      "ship_dates.fiscal_year"
    ],
    "calendar": [
      "dates.calendar_year",
      "due_dates.calendar_year",
      "ship_dates.calendar_year"
    ]
  },
  "cubes": {
    "dates": {
      "joins": []
    },
    "internet_sales": {
      "joins": [
        "customers",
        "dates",
        "due_dates",
        "products",
        "ship_dates",
        "territories"
      ]
    },
    "products": {
      "joins": []
    },
    "reseller_sales": {
      "joins": [
        "dates",
        "due_dates",
        "products",
        "ship_dates",
        "territories"
      ]
    },
    "territories": {
      "joins": []
    }
  }
}
