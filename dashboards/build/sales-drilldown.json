{
  "spec": 1,
  "id": "sales-drilldown",
  "title": "Sales drill-down",
  "description": "Revenue over time that drills from year to month to day, a donut by subcategory and columns by category. Every click filters the rest.",
  "tags": [
    "sales"
  ],
  "locale": "en-US",
  "currency": "USD",
  "roles": [
    "admin",
    "manager"
  ],
  "time": {
    "dimension": "dates.full_date",
    "fiscal_year_start": 7
  },
  "filters": [
    {
      "id": "category",
      "dimension": "products.category",
      "label": "Category"
    },
    {
      "id": "subcategory",
      "dimension": "products.subcategory",
      "label": "Subcategory",
      "parent": "products.category"
    },
    {
      "id": "region",
      "dimension": "territories.region",
      "label": "Region"
    }
  ],
  "panels": [
    {
      "id": "kpis",
      "type": "kpi",
      "measures": [
        {
          "sum": [
            "internet_sales.revenue",
            "reseller_sales.revenue"
          ],
          "label": "Revenue",
          "format": "money"
        },
        {
          "sum": [
            "internet_sales.orders",
            "reseller_sales.orders"
          ],
          "label": "Orders",
          "format": "int"
        },
        {
          "ratio": {
            "num": [
              "internet_sales.revenue",
              "reseller_sales.revenue"
            ],
            "den": [
              "internet_sales.orders",
              "reseller_sales.orders"
            ]
          },
          "label": "Avg order value",
          "format": "money"
        },
        {
          "sum": [
            "internet_sales.units",
            "reseller_sales.units"
          ],
          "label": "Units sold",
          "format": "int"
        }
      ],
      "sparkline": {
        "granularity": "month"
      }
    },
    {
      "id": "trend",
      "type": "timeseries",
      "title": "Revenue by channel",
      "series": [
        {
          "member": "internet_sales.revenue",
          "label": "Internet",
          "color": "internet",
          "format": "money"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller",
          "color": "reseller",
          "format": "money"
        }
      ],
      "granularity": "year",
      "drill": [
        "year",
        "month",
        "day"
      ],
      "style": "stacked-area"
    },
    {
      "id": "donut",
      "type": "pie",
      "title": "Revenue by subcategory",
      "sum": [
        "internet_sales.revenue",
        "reseller_sales.revenue"
      ],
      "label": "Revenue",
      "by": "products.subcategory",
      "by_label": "Subcategory",
      "limit": 8,
      "style": "donut",
      "format": "money",
      "on_click": {
        "set_filter": "subcategory"
      }
    },
    {
      "id": "categories",
      "type": "bar",
      "title": "Revenue by category",
      "orientation": "vertical",
      "stack": [
        {
          "member": "internet_sales.revenue",
          "label": "Internet",
          "color": "internet"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller",
          "color": "reseller"
        }
      ],
      "by": "products.category",
      "sort": "desc",
      "limit": 6,
      "format": "money",
      "on_click": {
        "set_filter": "category"
      }
    },
    {
      "id": "regions",
      "type": "bar",
      "title": "Revenue by region",
      "stack": [
        {
          "member": "internet_sales.revenue",
          "label": "Internet",
          "color": "internet"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller",
          "color": "reseller"
        }
      ],
      "by": "territories.region",
      "sort": "desc",
      "limit": 10,
      "format": "money",
      "on_click": {
        "set_filter": "region"
      }
    },
    {
      "id": "detail",
      "type": "table",
      "title": "Revenue by subcategory",
      "columns": [
        {
          "member": "products.category",
          "label": "Category"
        },
        {
          "member": "products.subcategory",
          "label": "Subcategory"
        },
        {
          "member": "internet_sales.revenue",
          "label": "Internet revenue",
          "format": "money"
        },
        {
          "member": "reseller_sales.revenue",
          "label": "Reseller revenue",
          "format": "money"
        },
        {
          "member": "internet_sales.margin_pct",
          "label": "Internet margin",
          "format": "pct"
        },
        {
          "member": "reseller_sales.margin_pct",
          "label": "Reseller margin",
          "format": "pct"
        }
      ],
      "order": {
        "internet_sales.revenue": "desc"
      },
      "limit": 50,
      "totals": "footer",
      "on_click": {
        "set_filter": [
          "category",
          "subcategory"
        ]
      }
    }
  ],
  "layout": [
    [
      {
        "panel": "kpis",
        "span": 12
      }
    ],
    [
      {
        "panel": "trend",
        "span": 7
      },
      {
        "panel": "donut",
        "span": 5
      }
    ],
    [
      {
        "panel": "categories",
        "span": 6
      },
      {
        "panel": "regions",
        "span": 6
      }
    ],
    [
      {
        "panel": "detail",
        "span": 12
      }
    ]
  ],
  "members": {
    "dates.full_date": {
      "kind": "dimension",
      "type": "time"
    },
    "internet_sales.margin_pct": {
      "kind": "measure",
      "type": "number"
    },
    "internet_sales.orders": {
      "kind": "measure",
      "type": "count_distinct"
    },
    "internet_sales.revenue": {
      "kind": "measure",
      "type": "sum"
    },
    "internet_sales.units": {
      "kind": "measure",
      "type": "sum"
    },
    "products.category": {
      "kind": "dimension",
      "type": "string"
    },
    "products.subcategory": {
      "kind": "dimension",
      "type": "string"
    },
    "reseller_sales.margin_pct": {
      "kind": "measure",
      "type": "number"
    },
    "reseller_sales.orders": {
      "kind": "measure",
      "type": "count_distinct"
    },
    "reseller_sales.revenue": {
      "kind": "measure",
      "type": "sum"
    },
    "reseller_sales.units": {
      "kind": "measure",
      "type": "sum"
    },
    "territories.region": {
      "kind": "dimension",
      "type": "string"
    }
  },
  "cubes": {
    "dates": {
      "joins": []
    },
    "internet_sales": {
      "joins": [
        "customers",
        "dates",
        "due_dates",
        "products",
        "ship_dates",
        "territories"
      ]
    },
    "products": {
      "joins": []
    },
    "reseller_sales": {
      "joins": [
        "dates",
        "due_dates",
        "products",
        "ship_dates",
        "territories"
      ]
    },
    "territories": {
      "joins": []
    }
  }
}
