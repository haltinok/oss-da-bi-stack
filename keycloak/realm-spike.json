{
  "realm": "spike",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "admin"
      },
      {
        "name": "manager"
      },
      {
        "name": "rep"
      },
      {
        "name": "purchasing"
      },
      {
        "name": "marketing"
      },
      {
        "name": "agent"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dashboard",
      "name": "Sales dashboard",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "${PUBLIC_URL}/*"
      ],
      "webOrigins": [
        "${PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PUBLIC_URL}/*"
      }
    }    ,
    {
      "clientId": "inventory-agent",
      "name": "Inventory proposal agent (service account, read-only data + draft proposals)",
      "enabled": true,
      "publicClient": false,
      "secret": "${AGENT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@spike.local",
      "firstName": "ADMIN",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "na_manager",
      "enabled": true,
      "emailVerified": true,
      "email": "na_manager@spike.local",
      "firstName": "NA",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "manager"
      ]
    },
    {
      "username": "de_rep",
      "enabled": true,
      "emailVerified": true,
      "email": "de_rep@spike.local",
      "firstName": "DE",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "rep"
      ]
    },
    {
      "username": "buyer",
      "enabled": true,
      "emailVerified": true,
      "email": "buyer@spike.local",
      "firstName": "BUYER",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "purchasing"
      ]
    },
    {
      "username": "marketer",
      "enabled": true,
      "emailVerified": true,
      "email": "marketer@spike.local",
      "firstName": "MARKETER",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "marketing"
      ]
    },
    {
      "username": "service-account-inventory-agent",
      "enabled": true,
      "serviceAccountClientId": "inventory-agent",
      "realmRoles": [
        "agent"
      ]
    }
  ]
}
