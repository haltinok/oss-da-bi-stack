{
  "realm": "spike",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "admin"
      },
      {
        "name": "manager"
      },
      {
        "name": "rep"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dashboard",
      "name": "Sales dashboard",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:${DASHBOARD_CUBE_PORT:8250}/*"
      ],
      "webOrigins": [
        "http://localhost:${DASHBOARD_CUBE_PORT:8250}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:${DASHBOARD_CUBE_PORT:8250}/*"
      }
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@spike.local",
      "firstName": "ADMIN",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "na_manager",
      "enabled": true,
      "emailVerified": true,
      "email": "na_manager@spike.local",
      "firstName": "NA",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "manager"
      ]
    },
    {
      "username": "de_rep",
      "enabled": true,
      "emailVerified": true,
      "email": "de_rep@spike.local",
      "firstName": "DE",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "rep"
      ]
    }
  ]
}
