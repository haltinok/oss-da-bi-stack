{
  "realm": "spike",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "admin"
      },
      {
        "name": "editor",
        "description": "Builds, changes and shares dashboards (and uses the SQL lab if given it). What data they read comes from their groups' datasets and row rules."
      },
      {
        "name": "viewer",
        "description": "Can only view dashboards: no building, designing, saving, SQL lab or administration."
      },
      {
        "name": "agent"
      }
    ]
  },
  "clients": [
    {
      "clientId": "dashboard",
      "name": "Sales dashboard",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "${PUBLIC_URL}/*"
      ],
      "webOrigins": [
        "${PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PUBLIC_URL}/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "inventory-agent",
      "name": "Inventory proposal agent (service account, read-only data + draft proposals)",
      "enabled": true,
      "publicClient": false,
      "secret": "${AGENT_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "admin-console",
      "name": "Admin console service (service account: manages users and groups)",
      "enabled": true,
      "publicClient": false,
      "secret": "${ADMIN_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@spike.local",
      "firstName": "ADMIN",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "na_manager",
      "enabled": true,
      "emailVerified": true,
      "email": "na_manager@spike.local",
      "firstName": "NA",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "editor"
      ],
      "groups": [
        "Managers"
      ]
    },
    {
      "username": "de_rep",
      "enabled": true,
      "emailVerified": true,
      "email": "de_rep@spike.local",
      "firstName": "DE",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "editor"
      ],
      "groups": [
        "Reps"
      ]
    },
    {
      "username": "buyer",
      "enabled": true,
      "emailVerified": true,
      "email": "buyer@spike.local",
      "firstName": "BUYER",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "editor"
      ],
      "groups": [
        "Purchasing"
      ]
    },
    {
      "username": "marketer",
      "enabled": true,
      "emailVerified": true,
      "email": "marketer@spike.local",
      "firstName": "MARKETER",
      "lastName": "Spike",
      "credentials": [
        {
          "type": "password",
          "value": "${TEST_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "editor"
      ],
      "groups": [
        "Marketing"
      ]
    },
    {
      "username": "service-account-inventory-agent",
      "enabled": true,
      "serviceAccountClientId": "inventory-agent",
      "realmRoles": [
        "agent"
      ]
    },
    {
      "username": "service-account-admin-console",
      "enabled": true,
      "serviceAccountClientId": "admin-console",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "query-groups",
          "view-realm"
        ]
      }
    }
  ],
  "groups": [
    {
      "name": "Managers"
    },
    {
      "name": "Reps"
    },
    {
      "name": "Purchasing"
    },
    {
      "name": "Marketing"
    }
  ]
}
