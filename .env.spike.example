# Copy to .env.spike and fill in. .env.spike is gitignored (.env.*).
# Generate secrets with:  openssl rand -hex 32

# --- Required ---
CUBEJS_API_SECRET=
CUBE_SQL_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=

# --- Optional (defaults shown) ---
