# STARROCKS_HTTP_PORT=8030
# CUBE_PORT=4000
# CUBE_SQL_PORT=15432
# KEYCLOAK_PORT=8180
# AUTH_PORT=8200

# --- SQL Server source (Phase 1) ---
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DB=AdventureWorks2016
MSSQL_USER=
MSSQL_PASSWORD=
