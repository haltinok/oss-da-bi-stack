# Copy this file to .env and fill in real values before running docker compose up

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=changeme

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=changeme_superset_secret

# Shared Postgres password (warehouse, CDC source, Airflow metadata, Superset metadata).
POSTGRES_PASSWORD=postgres

# Published host ports. Override any of these if they clash with another stack
# on the same machine; the container-side ports never change.
POSTGRES_PORT=5433
POSTGRES_ACTIVE_PORT=5434
AIRFLOW_PORT=8080
SUPERSET_PORT=8089
SUPERSET_MCP_PORT=5008
KAFKA_CONNECT_PORT=8083
KAFKA_UI_PORT=8081
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
