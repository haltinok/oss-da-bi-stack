# Copy this file to .env and fill in real values before running docker compose up.
# Easiest path: run `./scripts/generate-env.sh` (writes strong random values).
#
# Every value below is REQUIRED: docker compose fails fast if one is missing
# rather than silently starting with a weak placeholder.

AIRFLOW_ADMIN_USER=admin
# Change this: it is the Airflow UI password.
AIRFLOW_ADMIN_PASSWORD=REPLACE_ME

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (or let scripts/generate-env.sh do it)
AIRFLOW_FERNET_KEY=REPLACE_ME
AIRFLOW_WEBSERVER_SECRET_KEY=REPLACE_ME
AIRFLOW_API_AUTH__JWT_SECRET=REPLACE_ME

# Shared Postgres password (warehouse, CDC source, Airflow metadata, the postgres_active source for ingestr).
# The dlt pipelines take it from this variable at runtime, so there is one source of truth.
POSTGRES_PASSWORD=REPLACE_ME

# Simulator tuning (optional): per-run chance of creating a new sales order.
# Leave empty to derive it from the seeded history's last 365 days (~0.017,
# 4.8 orders/day), which keeps the live series continuous with the history.
# Set it to pin a livelier rate instead: 0.05 is ~14 orders/day, at the cost of
# a visible step where the backfill takes over from the history.
SIM_ORDER_CHANCE=
# Per-run chance an eligible order advances toward shipped (0.25), or is
# rejected/cancelled (0.05).
STATUS_ADVANCE_CHANCE=0.25
STATUS_CANCEL_CHANCE=0.05

# Password of the `debezium` replication user in postgres_active (created on first
# start of that volume; changing it later requires recreating the volume).
DEBEZIUM_PASSWORD=REPLACE_ME

# ClickHouse `clickhouse` user password (the CDC sink).
CLICKHOUSE_PASSWORD=REPLACE_ME

# --- `starrocks` profile (StarRocks + Cube + Keycloak sign-in). Generate each with: openssl rand -hex 16
# Signs the short-lived Cube tokens; shared by Cube and the auth service.
CUBEJS_API_SECRET=REPLACE_ME
# Read-only StarRocks users: Cube reads the mart as cube_ro; the auth service looks up
# a user's territories as auth_ro.
CUBE_DB_PASSWORD=REPLACE_ME
AUTH_DB_PASSWORD=REPLACE_ME
# Keycloak admin console login, and the password of the demo users (admin, na_manager,
# de_rep) imported with the realm. Demo only: a real deployment uses the bank's identity provider.
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME
TEST_USER_PASSWORD=REPLACE_ME

# Optional: a SQL Server source for the spike's ingest (spike/ingest/run.sh). Leave empty if unused.
# Use a read-only login.
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DB=AdventureWorks2016
MSSQL_USER=
MSSQL_PASSWORD=

# Published host ports. Override any of these if they clash with another stack
# on the same machine; the container-side ports never change.
POSTGRES_PORT=5433
POSTGRES_ACTIVE_PORT=5434
AIRFLOW_PORT=8080
KAFKA_CONNECT_PORT=8083
KAFKA_UI_PORT=8081
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
# `starrocks` profile
STARROCKS_MYSQL_PORT=9030
STARROCKS_HTTP_PORT=8030
CUBE_PORT=4000
KEYCLOAK_PORT=8180
AUTH_PORT=8200
DASHBOARD_CUBE_PORT=8250
