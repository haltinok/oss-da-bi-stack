# Copy this file to .env and fill in real values before running docker compose up.
# Easiest path: run `./scripts/generate-env.sh` (writes strong random values).
#
# Every value below is REQUIRED: docker compose fails fast if one is missing
# rather than silently starting with a weak placeholder.

AIRFLOW_ADMIN_USER=admin
# Change this: it is the Airflow UI password.
AIRFLOW_ADMIN_PASSWORD=REPLACE_ME

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# (or let scripts/generate-env.sh do it)
AIRFLOW_FERNET_KEY=REPLACE_ME
AIRFLOW_WEBSERVER_SECRET_KEY=REPLACE_ME
AIRFLOW_API_AUTH__JWT_SECRET=REPLACE_ME

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=REPLACE_ME

# Superset UI admin login (created by superset-init).
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=REPLACE_ME
# Superset's default UI language (optional): `tr` (the stack default) or `en`.
SUPERSET_DEFAULT_LOCALE=tr

# Metabase session/credential encryption key. Metabase requires exactly 16, 24
# or 32 characters (NOT the 64-char hex used for the others); the generator
# produces 32. Changing it after first start makes stored credentials unreadable.
METABASE_SECRET_KEY=REPLACE_ME

# Shared Postgres password (warehouse, CDC source, Airflow metadata, Superset metadata).
# The dlt pipelines take it from this variable at runtime, so there is one source of truth.
POSTGRES_PASSWORD=REPLACE_ME

# Read-only password for the BI tools (Superset/Metabase). They connect as the
# `bi_ro` role, which can only SELECT from the `mart` schema -- not the superuser.
BI_READONLY_PASSWORD=REPLACE_ME

# Simulator tuning (optional): per-run chance of creating a new sales order.
# 0.05 is ~14 orders/day; 0.01 matches the seeded history's rate.
SIM_ORDER_CHANCE=0.05
# Per-run chance an eligible order advances toward shipped (0.25), or is
# rejected/cancelled (0.05).
STATUS_ADVANCE_CHANCE=0.25
STATUS_CANCEL_CHANCE=0.05

# Password of the `debezium` replication user in postgres_active (created on first
# start of that volume; changing it later requires recreating the volume).
DEBEZIUM_PASSWORD=REPLACE_ME

# ClickHouse `clickhouse` user password (superset connects with it to the cdc database).
CLICKHOUSE_PASSWORD=REPLACE_ME

# Published host ports. Override any of these if they clash with another stack
# on the same machine; the container-side ports never change.
POSTGRES_PORT=5433
POSTGRES_ACTIVE_PORT=5434
AIRFLOW_PORT=8080
SUPERSET_PORT=8089
SUPERSET_MCP_PORT=5008
METABASE_PORT=3001
DASHBOARD_PORT=8050
KAFKA_CONNECT_PORT=8083
KAFKA_UI_PORT=8081
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
